# Vercel Postgres / Neon connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs team + client portal login sessions. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Resend (email notifications) — https://resend.com
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="updates@arandmedia.com"

# Vercel Blob (document storage) — auto-added when a Blob store is connected
# to the Vercel project. https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""
