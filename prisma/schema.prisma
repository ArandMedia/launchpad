// LaunchPAD data model
// Shared spine between the internal team app and the client portal.
// Designed so client-portal queries are always scoped by clientId + indexed,
// since this needs to stay fast even at hundreds of thousands of clients/projects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum DocumentCategory {
  CONTRACT
  INVOICE
  SOW
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole @default(TEAM)
  passwordHash String
  createdAt    DateTime @default(now())

  assignedTasks Task[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String   @unique
  phone       String?
  // Portal login — client sees only projects linked to this id
  slug         String   @unique // used in portal URL, e.g. /portal/acme-co
  passwordHash String?  // set when the team creates portal access; null = no portal login yet
  createdAt    DateTime @default(now())
  archivedAt   DateTime? // soft-archived clients drop out of default lists but keep their history

  projects Project[]

  @@index([slug])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  // Scope: the working brief the whole project hangs off. Kept as three
  // separate fields (not one blob) so both the internal dashboard and the
  // client portal can render "what's the problem / what are we building /
  // what does done look like" as a clean, scannable summary rather than a
  // wall of text.
  problem         String?
  solution        String?
  desiredOutcome  String?
  status      ProjectStatus @default(DISCOVERY)
  startDate   DateTime?
  targetDate  DateTime?
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime? // soft-archived projects drop out of default lists but keep their history

  tasks       Task[]
  milestones  Milestone[]
  updates     Update[]
  documents   Document[]

  @@index([clientId])
  @@index([status])
  @@index([updatedAt])
}

model Task {
  id         String     @id @default(cuid())
  title      String
  status     TaskStatus @default(TODO)
  dueDate    DateTime?
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee   User?      @relation(fields: [assigneeId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Milestone {
  id              String    @id @default(cuid())
  title           String
  description     String?
  targetDate      DateTime?
  completedAt     DateTime?
  clientVisible   Boolean   @default(true)
  notifyOnComplete Boolean  @default(true)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([projectId])
}

// Timestamped log — internal notes AND client-visible updates live here,
// distinguished by clientVisible. This is what powers both the internal
// activity feed and the client dashboard's "what's happening" feed.
model Update {
  id            String   @id @default(cuid())
  body          String
  clientVisible Boolean  @default(false)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  authorId      String?
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, clientVisible])
}

// Contracts, invoices, SOWs, and other project files. Files themselves live
// in Vercel Blob storage -- this row is just the pointer + metadata, kept
// strictly scoped to one project so a client's portal query (filtered by
// clientVisible + projectId via the project relation) never crosses into
// another project's or another client's files.
model Document {
  id            String           @id @default(cuid())
  title         String
  category      DocumentCategory @default(OTHER)
  url           String
  fileName      String
  fileSize      Int
  mimeType      String
  clientVisible Boolean          @default(false)
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id])
  uploadedById  String?
  createdAt     DateTime         @default(now())

  @@index([projectId])
  @@index([projectId, clientVisible])
}

model NotificationLog {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  recipient  String
  subject    String
  projectId  String
  sentAt     DateTime            @default(now())
  success    Boolean             @default(true)

  @@index([projectId])
}

// Private reference material (study notes, playbooks) shown inside the
// internal app at /reference/[slug]. The page body lives here rather than
// in the codebase so the content stays out of the public repository.
// Admin-only: see app/reference/[slug]/route.ts.
model ReferenceDoc {
  slug      String   @id
  title     String
  html      String
  updatedAt DateTime @updatedAt
}


// LifeOS data is isolated by the authenticated owner's user ID.
// No sensitive health measurements are stored in this first iteration.
model LifeOSGoal {
  id          String    @id @default(cuid())
  ownerId     String
  title       String
  horizon     String
  parentId    String?
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId, createdAt])
  @@index([ownerId, parentId])
}

model LifeOSReview {
  id        String   @id @default(cuid())
  ownerId   String
  date      DateTime @db.Date
  intended  String   @default("")
  actual    String   @default("")
  learned   String   @default("")
  next      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, date])
  @@index([ownerId, date])
}
