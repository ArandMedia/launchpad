// LaunchPAD data model
// Shared spine between the internal team app and the client portal.
// Designed so client-portal queries are always scoped by clientId + indexed,
// since this needs to stay fast even at hundreds of thousands of clients/projects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationChannel {
  EMAIL
  SMS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(TEAM)
  createdAt DateTime @default(now())

  assignedTasks Task[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String   @unique
  phone       String?
  // Portal login — client sees only projects linked to this id
  slug        String   @unique // used in portal URL, e.g. /portal/acme-co
  createdAt   DateTime @default(now())

  projects Project[]

  @@index([slug])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(DISCOVERY)
  startDate   DateTime?
  targetDate  DateTime?
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]
  milestones  Milestone[]
  updates     Update[]

  @@index([clientId])
  @@index([status])
  @@index([updatedAt])
}

model Task {
  id         String     @id @default(cuid())
  title      String
  status     TaskStatus @default(TODO)
  dueDate    DateTime?
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee   User?      @relation(fields: [assigneeId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Milestone {
  id              String    @id @default(cuid())
  title           String
  description     String?
  targetDate      DateTime?
  completedAt     DateTime?
  clientVisible   Boolean   @default(true)
  notifyOnComplete Boolean  @default(true)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([projectId])
}

// Timestamped log — internal notes AND client-visible updates live here,
// distinguished by clientVisible. This is what powers both the internal
// activity feed and the client dashboard's "what's happening" feed.
model Update {
  id            String   @id @default(cuid())
  body          String
  clientVisible Boolean  @default(false)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  authorId      String?
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, clientVisible])
}

model NotificationLog {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  recipient  String
  subject    String
  projectId  String
  sentAt     DateTime            @default(now())
  success    Boolean             @default(true)

  @@index([projectId])
}
