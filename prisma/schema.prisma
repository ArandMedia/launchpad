// LaunchPAD data model
// Shared spine between the internal team app and the client portal.
// Designed so client-portal queries are always scoped by clientId + indexed,
// since this needs to stay fast even at hundreds of thousands of clients/projects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum DocumentCategory {
  CONTRACT
  INVOICE
  SOW
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole @default(TEAM)
  passwordHash String
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())

  assignedTasks Task[]
}

model Client {
  id           String    @id @default(cuid())
  name         String
  companyName  String?
  email        String    @unique
  phone        String?
  // Portal login — client sees only projects linked to this id
  slug         String    @unique // used in portal URL, e.g. /portal/acme-co
  passwordHash String? // set when the team creates portal access; null = no portal login yet
  createdAt    DateTime  @default(now())
  archivedAt   DateTime? // soft-archived clients drop out of default lists but keep their history

  projects Project[]

  @@index([slug])
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  // Scope: the working brief the whole project hangs off. Kept as three
  // separate fields (not one blob) so both the internal dashboard and the
  // client portal can render "what's the problem / what are we building /
  // what does done look like" as a clean, scannable summary rather than a
  // wall of text.
  problem        String?
  solution       String?
  desiredOutcome String?
  status         ProjectStatus @default(DISCOVERY)
  startDate      DateTime?
  targetDate     DateTime?
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime? // soft-archived projects drop out of default lists but keep their history

  tasks      Task[]
  milestones Milestone[]
  updates    Update[]
  documents  Document[]
  timeBlocks LifeOSTimeBlock[]

  @@index([clientId])
  @@index([status])
  @@index([updatedAt])
}

model Task {
  id         String            @id @default(cuid())
  title      String
  status     TaskStatus        @default(TODO)
  dueDate    DateTime?
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee   User?             @relation(fields: [assigneeId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  timeBlocks LifeOSTimeBlock[]

  @@index([projectId])
  @@index([assigneeId])
}

model Milestone {
  id               String            @id @default(cuid())
  title            String
  description      String?
  targetDate       DateTime?
  completedAt      DateTime?
  clientVisible    Boolean           @default(true)
  notifyOnComplete Boolean           @default(true)
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  createdAt        DateTime          @default(now())
  timeBlocks       LifeOSTimeBlock[]

  @@index([projectId])
}

// Timestamped log — internal notes AND client-visible updates live here,
// distinguished by clientVisible. This is what powers both the internal
// activity feed and the client dashboard's "what's happening" feed.
model Update {
  id            String   @id @default(cuid())
  body          String
  clientVisible Boolean  @default(false)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  authorId      String?
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, clientVisible])
}

// Contracts, invoices, SOWs, and other project files. Files themselves live
// in Vercel Blob storage -- this row is just the pointer + metadata, kept
// strictly scoped to one project so a client's portal query (filtered by
// clientVisible + projectId via the project relation) never crosses into
// another project's or another client's files.
model Document {
  id            String           @id @default(cuid())
  title         String
  category      DocumentCategory @default(OTHER)
  url           String
  fileName      String
  fileSize      Int
  mimeType      String
  clientVisible Boolean          @default(false)
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id])
  uploadedById  String?
  createdAt     DateTime         @default(now())

  @@index([projectId])
  @@index([projectId, clientVisible])
}

model NotificationLog {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  recipient String
  subject   String
  projectId String
  sentAt    DateTime            @default(now())
  success   Boolean             @default(true)

  @@index([projectId])
}

// Private reference material (study notes, playbooks) shown inside the
// internal app at /reference/[slug]. The page body lives here rather than
// in the codebase so the content stays out of the public repository.
// Admin-only: see app/reference/[slug]/route.ts.
model ReferenceDoc {
  slug      String   @id
  title     String
  html      String
  updatedAt DateTime @updatedAt
}

// LifeOS data is isolated by the authenticated owner's user ID.
// No sensitive health measurements are stored in this first iteration.
model LifeOSGoal {
  id          String            @id @default(cuid())
  ownerId     String
  title       String
  purpose     String            @default("")
  nodeType    String            @default("OUTCOME")
  horizon     String
  parentId    String?
  done        Boolean           @default(false)
  completedAt DateTime?
  startAt     DateTime?         @db.Timestamptz(3)
  endAt       DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  domainKey   String            @default("OMNIS")
  targetValue Float?
  targetUnit  String            @default("")
  targetDate  DateTime?         @db.Date
  timeBlocks  LifeOSTimeBlock[]

  @@index([ownerId, createdAt])
  @@index([ownerId, parentId])
  @@index([ownerId, startAt])
  @@index([ownerId, domainKey])
  @@index([ownerId, targetDate])
}

// Daily execution is intentionally separate from long-horizon goals. A block
// can stand alone or point at an objective without changing that objective's
// own planning span.
model LifeOSTimeBlock {
  id          String      @id @default(cuid())
  ownerId     String
  title       String
  note        String      @default("")
  category    String      @default("")
  status      String      @default("PLANNED")
  startAt     DateTime    @db.Timestamptz(3)
  endAt       DateTime    @db.Timestamptz(3)
  objectiveId String?
  objective   LifeOSGoal? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId, startAt])
  @@index([ownerId, status])
  @@index([objectiveId])
  @@index([projectId])
  @@index([taskId])
  @@index([milestoneId])
}

model LifeOSReview {
  id        String   @id @default(cuid())
  ownerId   String
  date      DateTime @db.Date
  intended  String   @default("")
  actual    String   @default("")
  learned   String   @default("")
  next      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, date])
  @@index([ownerId, date])
}

model LifeOSDomainState {
  id           String   @id @default(cuid())
  ownerId      String
  domainKey    String
  currentState String   @default("")
  desiredState String   @default("")
  gap          String   @default("")
  activeSystem String   @default("")
  nextActions  String   @default("")
  evidence     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, domainKey])
  @@index([ownerId, updatedAt])
}

model LifeOSRoutine {
  id        String   @id @default(cuid())
  ownerId   String
  domainKey String
  title     String
  cadence   String   @default("WEEKLY")
  active    Boolean  @default(true)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, domainKey, active])
}

model LifeOSAction {
  id           String    @id @default(cuid())
  ownerId      String
  domainKey    String
  title        String
  status       String    @default("OPEN")
  dueAt        DateTime? @db.Timestamptz(3)
  legacyGoalId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId, domainKey, status])
  @@index([ownerId, dueAt])
}

model LifeOSMetricDefinition {
  id                 String                    @id @default(cuid())
  ownerId            String
  metricKey          String?
  domainKey          String
  name               String
  unit               String                    @default("")
  direction          String                    @default("NEUTRAL")
  sensitivity        String                    @default("STANDARD")
  active             Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  measurements       LifeOSMeasurement[]
  healthMeasurements LifeOSHealthMeasurement[]

  @@unique([ownerId, metricKey])
  @@index([ownerId, domainKey, active])
}

model LifeOSMeasurement {
  id         String                 @id @default(cuid())
  ownerId    String
  metricId   String
  metric     LifeOSMetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  value      Float
  note       String                 @default("")
  source     String                 @default("MANUAL")
  observedAt DateTime               @db.Timestamptz(3)
  createdAt  DateTime               @default(now())

  @@index([ownerId, metricId, observedAt])
}

// Health readings are stored separately and encrypted by the application.
model LifeOSHealthMeasurement {
  id         String                 @id @default(cuid())
  ownerId    String
  metricId   String
  metric     LifeOSMetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  ciphertext String
  iv         String
  authTag    String
  source     String                 @default("MANUAL")
  observedAt DateTime               @db.Timestamptz(3)
  createdAt  DateTime               @default(now())

  @@index([ownerId, metricId, observedAt])
}

model LifeOSPrinciple {
  id        String   @id @default(cuid())
  ownerId   String
  domainKey String
  title     String
  statement String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, domainKey, active])
}

model LifeOSRelationshipCommitment {
  id        String   @id @default(cuid())
  ownerId   String
  area      String
  title     String
  cadence   String   @default("")
  note      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, area, active])
}

model LifeOSReviewCycle {
  id             String   @id @default(cuid())
  ownerId        String
  period         String
  periodStart    DateTime @db.Date
  domainKey      String?
  observation    String   @default("")
  recommendation String   @default("")
  decision       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ownerId, period, periodStart, domainKey])
  @@index([ownerId, periodStart])
}

model LifeOSIntegrationConnection {
  id             String    @id @default(cuid())
  ownerId        String
  providerKey    String
  domainKey      String
  status         String    @default("NOT_CONNECTED")
  scopes         String[]  @default([])
  consentedAt    DateTime?
  disconnectedAt DateTime?
  retentionDays  Int       @default(365)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ownerId, providerKey])
  @@index([ownerId, domainKey, status])
}

// Public iCloud subscription URLs are bearer secrets even though the feed is
// read-only, so the URL is stored as authenticated ciphertext.
model LifeOSCalendarFeed {
  id            String    @id @default(cuid())
  ownerId       String
  name          String
  color         String    @default("#8b5cf6")
  urlCiphertext String
  iv            String
  authTag       String
  active        Boolean   @default(true)
  lastSyncedAt  DateTime?
  lastError     String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId, active])
}

// Append-only user-visible audit trail for LifeOS mutations.
model LifeOSActivity {
  id         String   @id @default(cuid())
  ownerId    String
  domainKey  String
  entityType String
  entityId   String
  action     String
  summary    String
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([ownerId, domainKey, createdAt])
}

// Private searchable writing. Apple Pencil ink is stored beside the typed or
// Scribble-converted text; text remains the searchable source of truth.
model LifeOSJournalEntry {
  id         String   @id @default(cuid())
  ownerId    String
  kind       String   @default("NOTE")
  title      String
  body       String   @default("")
  tags       String[] @default([])
  inkData    String   @default("")
  occurredOn DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId, occurredOn])
  @@index([ownerId, kind, updatedAt])
}
